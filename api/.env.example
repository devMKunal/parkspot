NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/parkspot
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BOOKING_LOCK_MINUTES=10
# Razorpay test keys: Dashboard → Account & Settings → API Keys (test mode). Leave empty to disable booking.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhooks → Add webhook → URL https://<api-host>/v1/webhooks/razorpay,
# events payment.authorized, payment.captured, order.paid. Use the same secret here.
# Required when NODE_ENV=production: the API won't start without it.
RAZORPAY_WEBHOOK_SECRET=
# Comma-separated; empty means no browser origins (the mobile app does not need CORS)
CORS_ORIGINS=
