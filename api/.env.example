NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://localhost:27017/parkspot
# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Comma-separated; empty means no browser origins (the mobile app does not need CORS)
CORS_ORIGINS=
