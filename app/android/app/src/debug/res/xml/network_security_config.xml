<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets the app reach the local API over plain HTTP, on the
     emulator (10.0.2.2) or a phone (your Mac's LAN IP, which changes per network,
     so it can't be listed here). Release builds keep Android's default: HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
